# Copy to `.env` and edit. Every value here has a working default in
# docker-compose.yml; set only what you need to change.
#
# LEWLM_DOCKER_* names are read by Compose to build and wire the container.
# They are deliberately namespaced apart from LewLM's own LEWLM_* runtime
# settings (LEWLM_MODELS_DIR, for instance, is a real setting naming a path
# *inside* the container). LEWLM_GPU_OFFLOAD_LAYERS is the one exception:
# it is passed straight through to the runtime and keeps its real name.

# Host directory holding your models, bind-mounted read-only at /data/models.
# Windows: use forward slashes, e.g. C:/Users/you/.lewlm/models
# macOS/Linux: e.g. /Users/you/.lewlm/models
LEWLM_DOCKER_MODELS_DIR=./models

# Host port to publish the API on.
LEWLM_DOCKER_PORT=8080

# Image flavor: bridge (no local runtime), serving (llama.cpp GGUF runtime),
# or full (serving + HF->GGUF conversion + documents/OCR). Default: full.
# LEWLM_DOCKER_IMAGE_FLAVOR=full

# Extra pyproject extras layered on top of the flavor (legacy knob; the flavor
# already carries everything it needs).
# LEWLM_DOCKER_EXTRAS=

# Parallel native compile jobs. 4 is safe for laptops and CI; raise on a large
# build host.
# LEWLM_DOCKER_BUILD_JOBS=4

# Prebuilt llama-cpp-python wheel index for this Python/architecture, e.g.
# https://abetlen.github.io/llama-cpp-python/whl/cpu (or /whl/cu126 for the
# CUDA image). Skips the source build; the image still verifies the wheel's
# flavor. Leave unset to compile from source under ccache.
# LEWLM_DOCKER_LLAMA_CPP_PYTHON_WHEEL_INDEX=

# Pinned, hashed dependency lock produced by scripts/docker/lock_dependencies.sh.
# Defaults to the unpinned requirements/<flavor>.txt export.
# LEWLM_DOCKER_DEPENDENCY_INPUT=requirements/locks/serving-linux-x86_64-py311.txt

# Pinned llama.cpp revision for the bundled HF->GGUF conversion tools.
# LEWLM_DOCKER_LLAMA_CPP_REF=b10698

# Set to `disabled` to skip building the conversion tools (leaner CI image).
# LEWLM_DOCKER_CONVERSION_TOOLS=enabled

# Land converted GGUFs on the host instead of inside the named volume.
# Uncomment the matching bind mount in docker-compose.yml as well.
# LEWLM_DOCKER_CONVERSIONS_DIR=./conversions

### NVIDIA GPU (the `gpu` compose profile) ####################################

# Your GPU's compute capability. 75=Turing, 80=Ampere, 86=Ampere, 89=Ada,
# 90=Hopper, 120=Blackwell / RTX 50-series. Check with:
#   nvidia-smi --query-gpu=compute_cap --format=csv
# LEWLM_DOCKER_CUDA_ARCHITECTURES=75;80;86;89

# Blackwell (sm_120) needs CUDA >= 12.8; the 12.6 default cannot build for it
# and the build refuses the SM up front rather than failing after compiling.
# Keep the devel and runtime tags and the torch index on the same CUDA version,
# and on a base image carrying Python >= 3.11 (the ubuntu22.04 CUDA images
# ship 3.10).
# LEWLM_DOCKER_CUDA_DEVEL_IMAGE=12.8.0-devel-ubuntu24.04
# LEWLM_DOCKER_CUDA_RUNTIME_IMAGE=12.8.0-runtime-ubuntu24.04
# LEWLM_DOCKER_TORCH_INDEX_URL=https://download.pytorch.org/whl/cu128

# Layers offloaded to the GPU. -1 offloads every layer (the image default);
# lower it for models that exceed your VRAM.
# LEWLM_GPU_OFFLOAD_LAYERS=-1
