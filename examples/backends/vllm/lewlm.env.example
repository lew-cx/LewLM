# LewLM settings for the vLLM recipe. Source or copy into your environment.
# The endpoint id `vllm` becomes part of every discovered model's id and
# source URI (external://vllm/<served model name>).

# Same value the container was started with (VLLM_API_KEY in docker-compose.yml).
export VLLM_API_KEY=replace-with-inference-key

export LEWLM_EXTERNAL_ENDPOINTS='[{"endpoint_id":"vllm","profile":"vllm_local","base_url":"http://127.0.0.1:8000/v1","api_key_env":"VLLM_API_KEY","read_timeout_seconds":120}]'

# `vllm_local` is the Linux/NVIDIA vLLM server. `vllm_mlx` is a different
# profile for the Apple Silicon fork and must not be used for this recipe.

# Optional: keep the default routing order; only add an alias if you want an
# automatic stand-in when the vLLM endpoint is down (see the routing guide).
# export LEWLM_EXTERNAL_FALLBACK_POLICY=explicit_alias
# export LEWLM_EXTERNAL_FALLBACK_ALIASES='{"<vllm model id>":"<local model id>"}'
