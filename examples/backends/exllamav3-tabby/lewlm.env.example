# LewLM settings for the TabbyAPI / ExLlamaV3 recipe.
export TABBY_API_KEY=replace-with-inference-key    # = api_key in api_tokens.yml, never admin_key

export LEWLM_EXTERNAL_ENDPOINTS='[{"endpoint_id":"tabby","profile":"exllamav3_tabby","base_url":"http://127.0.0.1:5000/v1","api_key_env":"TABBY_API_KEY","read_timeout_seconds":120}]'
