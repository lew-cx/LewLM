# LewLM settings for the oMLX recipe. Source or copy into your environment.
# The endpoint id `omlx` becomes part of every discovered model's id and
# source URI (external://omlx/<upstream id>).

# Same value the server was started with; LewLM reads it from this variable.
export OMLX_API_KEY=change-me

export LEWLM_EXTERNAL_ENDPOINTS='[{"endpoint_id":"omlx","profile":"omlx","base_url":"http://127.0.0.1:8000/v1","api_key_env":"OMLX_API_KEY","read_timeout_seconds":120}]'

# Optional: keep the default routing order; only add an alias if you want an
# automatic stand-in when the oMLX endpoint is down (see the routing guide).
# export LEWLM_EXTERNAL_FALLBACK_POLICY=explicit_alias
# export LEWLM_EXTERNAL_FALLBACK_ALIASES='{"<omlx model id>":"<local model id>"}'
