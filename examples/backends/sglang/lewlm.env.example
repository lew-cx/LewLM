# LewLM settings for the SGLang recipe. Source or copy into your environment.
# The endpoint id `sglang` becomes part of every discovered model's id and
# source URI (external://sglang/<served model name>).

# Same value the container was started with (--api-key in docker-compose.yml).
export SGLANG_API_KEY=replace-with-inference-key

export LEWLM_EXTERNAL_ENDPOINTS='[{"endpoint_id":"sglang","profile":"sglang_local","base_url":"http://127.0.0.1:30000/v1","api_key_env":"SGLANG_API_KEY","read_timeout_seconds":120}]'

# Optional: keep the default routing order; only add an alias if you want an
# automatic stand-in when the SGLang endpoint is down (see the routing guide).
# export LEWLM_EXTERNAL_FALLBACK_POLICY=explicit_alias
# export LEWLM_EXTERNAL_FALLBACK_ALIASES='{"<sglang model id>":"<local model id>"}'
