# syntax=docker/dockerfile:1
#
# LewLM CUDA runtime image (NVIDIA GPU acceleration).
#
# This is the promoted path for LewLM on non-Apple NVIDIA hosts. It builds
# llama.cpp with the CUDA backend, resolves torch from the matching CUDA wheel
# index (full flavor only), and carries the llama.cpp conversion tools so
# `lewlm convert` is executable in the image. Run with the NVIDIA Container
# Toolkit:
#
#   docker build -f Dockerfile.cuda -t lewlm:cuda .
#   docker run --gpus all -p 8080:8080 -v "$HOME/.lewlm:/data" lewlm:cuda
#
# Flavors and layering are the same as Dockerfile (bridge / serving / full;
# dependencies keyed on requirements/<flavor>.txt, app wheel installed last).
# A `bridge` flavor makes little sense here -- use Dockerfile for that.
#
# Notes:
#  - CUDA_ARCHITECTURES must match your GPU. The default is the broad
#    compatibility profile (Turing..Ada). A per-device build is smaller and
#    faster to compile: e.g. --build-arg CUDA_ARCHITECTURES=89 on an Ada card.
#    The requested SMs are validated against the toolkit before anything is
#    compiled, so a Blackwell (120) request on the CUDA 12.6 default fails in
#    seconds with the supported list, not after a long build.
#  - `native` is refused: a distributable image must not depend on which GPU
#    was visible at build time.
#  - The CUDA toolkit/devel image is large; the resulting image is multi-GB.
#  - The base image must carry Python >= 3.11 to satisfy `requires-python`.
#    The ubuntu22.04 CUDA images ship Python 3.10, so these default to
#    ubuntu24.04 (Python 3.12); keep that floor when overriding the tags.
#  - Keep CUDA_DEVEL_IMAGE, CUDA_RUNTIME_IMAGE, and TORCH_INDEX_URL on the same
#    CUDA version.

ARG CUDA_DEVEL_IMAGE=12.6.2-devel-ubuntu24.04
ARG CUDA_RUNTIME_IMAGE=12.6.2-runtime-ubuntu24.04

# llama.cpp revision used for the conversion tools. Pinned so image builds are
# reproducible and so the GGUF files written here track a known llama.cpp.
ARG LLAMA_CPP_REF=b10698

# `enabled` (default) builds the conversion tools; `disabled` skips that build
# for lean images. When disabled, LewLM reports the configured converter as
# not found rather than silently dropping the capability.
ARG CONVERSION_TOOLS=enabled

ARG IMAGE_FLAVOR=full

# Parallel compile jobs for every native build in this file. nvcc is memory
# hungry; 4 is a safe default for desktops and CI. Raise it on a build server.
ARG BUILD_JOBS=4

###############################################################################
# llama.cpp conversion tools: HF->GGUF converter + GGUF quantizer             #
###############################################################################
# Quantization is CPU work, so this builds without the CUDA backend even though
# it shares the CUDA base -- matching the base keeps the binary's glibc and
# libstdc++ aligned with the runtime stage.
FROM nvidia/cuda:${CUDA_DEVEL_IMAGE} AS llamacpp-tools-enabled

ARG LLAMA_CPP_REF
ARG BUILD_JOBS
ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y --no-install-recommends \
        build-essential cmake ninja-build git ccache \
    && rm -rf /var/lib/apt/lists/*

RUN git clone --depth 1 --branch "${LLAMA_CPP_REF}" \
        https://github.com/ggml-org/llama.cpp.git /src/llama.cpp

WORKDIR /src/llama.cpp
ENV CCACHE_DIR=/root/.cache/ccache

RUN --mount=type=cache,id=lewlm-ccache-tools-cuda-${LLAMA_CPP_REF},target=/root/.cache/ccache \
    cmake -B build -G Ninja \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_C_COMPILER_LAUNCHER=ccache \
        -DCMAKE_CXX_COMPILER_LAUNCHER=ccache \
        -DGGML_NATIVE=OFF \
        -DBUILD_SHARED_LIBS=OFF \
        -DLLAMA_BUILD_COMMON=ON \
        -DLLAMA_BUILD_TOOLS=ON \
        -DLLAMA_BUILD_TESTS=OFF \
        -DLLAMA_BUILD_EXAMPLES=OFF \
        -DLLAMA_BUILD_SERVER=OFF \
        -DLLAMA_BUILD_APP=OFF \
        -DLLAMA_BUILD_UI=OFF \
        -DLLAMA_OPENSSL=OFF \
    && cmake --build build --target llama-quantize -j "${BUILD_JOBS}" \
    && ccache --show-stats

# `convert_hf_to_gguf.py` imports `conversion` and self-inserts `gguf-py` on
# sys.path relative to its own location, so all three have to stay siblings.
# LewLM's tool resolver recognises that layout and runs the converter with the
# directory as its working root.
RUN mkdir -p /opt/llamacpp-tools \
    && cp convert_hf_to_gguf.py /opt/llamacpp-tools/ \
    && cp -r gguf-py /opt/llamacpp-tools/gguf-py \
    && cp -r conversion /opt/llamacpp-tools/conversion \
    && install -Dm755 build/bin/llama-quantize /opt/llamacpp-tools/llama-quantize

###############################################################################
# Opt-out stage: an empty tool tree so the runtime COPY stays unconditional    #
###############################################################################
FROM nvidia/cuda:${CUDA_DEVEL_IMAGE} AS llamacpp-tools-disabled
RUN mkdir -p /opt/llamacpp-tools

FROM llamacpp-tools-${CONVERSION_TOOLS} AS llamacpp-tools

###############################################################################
# Toolchain: compilers, ccache, Python, an empty venv                         #
###############################################################################
FROM nvidia/cuda:${CUDA_DEVEL_IMAGE} AS toolchain

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y --no-install-recommends \
        python3 python3-venv python3-dev python3-pip \
        build-essential cmake ninja-build git ccache \
    && rm -rf /var/lib/apt/lists/*

RUN python3 -m venv /opt/venv
ENV PATH="/opt/venv/bin:${PATH}" \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    CCACHE_DIR=/root/.cache/ccache

RUN --mount=type=cache,id=lewlm-pip,target=/root/.cache/pip \
    pip install --upgrade pip

###############################################################################
# Dependencies: keyed on requirements/<flavor>.txt and the CUDA arguments     #
###############################################################################
FROM toolchain AS deps

ARG CUDA_DEVEL_IMAGE
ARG IMAGE_FLAVOR
ARG BUILD_JOBS
ARG DEPENDENCY_INPUT="requirements/${IMAGE_FLAVOR}.txt"

# Target GPU compute capabilities. Override for your hardware, e.g. 89 (Ada),
# 90 (Hopper), 120 (Blackwell / RTX 50-series, needs a CUDA >= 12.8 image).
ARG CUDA_ARCHITECTURES="75;80;86;89"

# Extra llama.cpp CMake flags appended after the CUDA ones.
ARG LLAMA_CMAKE_ARGS=""

# Prebuilt-wheel path, e.g. https://abetlen.github.io/llama-cpp-python/whl/cu126
# (the index name must match the CUDA version of this image). When set, no
# source build runs; the wheel must still prove CUDA offload in the app stage.
ARG LLAMA_CPP_PYTHON_WHEEL_INDEX=""

# torch comes from the CUDA-matched wheel index, never inferred from PyPI's
# default build. Only the full flavor installs torch.
ARG TORCH_INDEX_URL="https://download.pytorch.org/whl/cu126"

# Compiler-cache scope: toolchain identity only. ccache keys each object on
# the real compile line (including -gencode for the selected SMs) and the
# wheel directory below is keyed on the full CMake flags, so different SM sets
# share one ccache safely without ever sharing a wheel.
ARG CACHE_SCOPE="cuda-${CUDA_DEVEL_IMAGE}"

ENV CMAKE_BUILD_PARALLEL_LEVEL=${BUILD_JOBS} \
    MAX_JOBS=${BUILD_JOBS} \
    PIP_EXTRA_INDEX_URL=${TORCH_INDEX_URL}

WORKDIR /build
COPY ${DEPENDENCY_INPUT} ./requirements.txt
COPY scripts/docker/validate_cuda_archs.sh ./validate_cuda_archs.sh

# Fail fast on an SM the toolkit cannot target, before any compilation.
RUN sh ./validate_cuda_archs.sh "${CUDA_ARCHITECTURES}"

RUN --mount=type=cache,id=lewlm-pip,target=/root/.cache/pip \
    --mount=type=cache,id=lewlm-pip-native-${CACHE_SCOPE},target=/root/.cache/pip-native \
    --mount=type=cache,id=lewlm-ccache-${CACHE_SCOPE},target=/root/.cache/ccache \
    set -eu; \
    spec="$(grep -i '^llama[-_]cpp[-_]python' requirements.txt | head -n1 | sed 's/[[:space:]]*;.*$//; s/[[:space:]]*\\$//')"; \
    if [ -z "$spec" ]; then echo "flavor ${IMAGE_FLAVOR}: no llama-cpp-python in the dependency input; skipping"; exit 0; fi; \
    mkdir -p /wheels/native; \
    if [ -n "${LLAMA_CPP_PYTHON_WHEEL_INDEX}" ]; then \
        echo "llama-cpp-python: prebuilt wheel from ${LLAMA_CPP_PYTHON_WHEEL_INDEX}"; \
        pip download --only-binary llama-cpp-python --no-deps \
            --extra-index-url "${LLAMA_CPP_PYTHON_WHEEL_INDEX}" --dest /wheels/native "$spec"; \
    else \
        cmake_args="-DGGML_CUDA=on -DCMAKE_CUDA_ARCHITECTURES=${CUDA_ARCHITECTURES} ${LLAMA_CMAKE_ARGS}"; \
        abi="$(python -c 'import sysconfig; print(sysconfig.get_config_var("SOABI"))')"; \
        native_key="$(printf '%s|%s|%s' "${CACHE_SCOPE}" "${cmake_args}" "$abi" | sha256sum | cut -c1-16)"; \
        echo "llama-cpp-python: CUDA source build (CMAKE_ARGS='${cmake_args}', jobs=${BUILD_JOBS}, cache key ${native_key})"; \
        CMAKE_ARGS="${cmake_args} -DCMAKE_C_COMPILER_LAUNCHER=ccache -DCMAKE_CXX_COMPILER_LAUNCHER=ccache -DCMAKE_CUDA_COMPILER_LAUNCHER=ccache" \
        FORCE_CMAKE=1 \
        pip --cache-dir "/root/.cache/pip-native/${native_key}" wheel --no-deps \
            --no-binary llama-cpp-python --wheel-dir /wheels/native "$spec"; \
        ccache --show-stats; \
    fi; \
    pip install /wheels/native/llama_cpp_python-*.whl

RUN --mount=type=cache,id=lewlm-pip,target=/root/.cache/pip \
    pip install -r requirements.txt \
    && pip check

###############################################################################
# App: the only layer that changes when src/ changes                          #
###############################################################################
FROM deps AS app

ARG IMAGE_FLAVOR
ARG EXTRAS=""

WORKDIR /src
COPY pyproject.toml README.md LICENSE MANIFEST.in ./
COPY src ./src
COPY scripts/verify_llamacpp_build.py ./scripts/verify_llamacpp_build.py

RUN --mount=type=cache,id=lewlm-pip,target=/root/.cache/pip \
    set -eu; \
    pip wheel --no-deps --wheel-dir /wheels/app . ; \
    wheel="$(ls /wheels/app/lewlm-*.whl)"; \
    if [ -n "${EXTRAS}" ]; then pip install "${wheel}[${EXTRAS}]"; else pip install --no-deps "${wheel}"; fi; \
    pip check

# A CPU-only wheel installs just as cleanly as a CUDA one; refuse it here.
# `llama_supports_gpu_offload` reads the build's compile-time backend list, so
# this proof does not need a GPU at build time -- real offload and generation
# are verified on hardware with `lewlm runtime probe`.
RUN set -eu; \
    case "${IMAGE_FLAVOR}" in \
        serving) python -c "import importlib.util as u; bad=[m for m in ('torch','transformers','weasyprint') if u.find_spec(m)]; assert not bad, f'serving image must not contain {bad}'" ;; \
        full) : ;; \
        *) echo "IMAGE_FLAVOR '${IMAGE_FLAVOR}' is not supported by Dockerfile.cuda (expected serving or full)" >&2; exit 1 ;; \
    esac; \
    python scripts/verify_llamacpp_build.py --expect gpu --hint cuda; \
    lewlm --help >/dev/null

###############################################################################
ARG CUDA_RUNTIME_IMAGE=12.6.2-runtime-ubuntu24.04
FROM nvidia/cuda:${CUDA_RUNTIME_IMAGE} AS runtime
# Keep CUDA_RUNTIME_IMAGE's CUDA version aligned with CUDA_DEVEL_IMAGE above.

ARG IMAGE_FLAVOR
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends \
        python3 \
        libgomp1 \
        curl \
    && if [ "${IMAGE_FLAVOR}" = "full" ]; then \
        apt-get install -y --no-install-recommends \
            libpango-1.0-0 libpangocairo-1.0-0 libcairo2 libgdk-pixbuf-2.0-0 \
            tesseract-ocr; \
    fi \
    && rm -rf /var/lib/apt/lists/*

COPY --from=app /opt/venv /opt/venv
COPY --from=llamacpp-tools /opt/llamacpp-tools /opt/llamacpp-tools
ENV PATH="/opt/venv/bin:${PATH}"

RUN useradd --create-home --uid 10001 lewlm \
    && mkdir -p /data/models /data/cache \
    && chown -R lewlm:lewlm /data
USER lewlm

ENV LEWLM_HOST=0.0.0.0 \
    LEWLM_PORT=8080 \
    LEWLM_DATA_DIR=/data \
    HOME=/home/lewlm \
    NVIDIA_VISIBLE_DEVICES=all \
    NVIDIA_DRIVER_CAPABILITIES=compute,utility \
    # Reported by `lewlm doctor` so guidance suits the deployment shape.
    LEWLM_IN_CONTAINER=true \
    LEWLM_IMAGE_FLAVOR=${IMAGE_FLAVOR} \
    # Without this a CUDA build still loads models CPU-only: the setting
    # defaults to None, which asks llama.cpp for zero offloaded layers. -1
    # offloads every layer; lower it for models that exceed your VRAM.
    LEWLM_GPU_OFFLOAD_LAYERS=-1 \
    # The conversion path shells out to these; both live in the full image.
    LEWLM_LLAMACPP_CONVERT_HF_TO_GGUF_PATH=/opt/llamacpp-tools/convert_hf_to_gguf.py \
    LEWLM_LLAMACPP_QUANTIZE_PATH=/opt/llamacpp-tools/llama-quantize \
    # The tool tree is read-only to this user; skip the bytecode write attempts.
    PYTHONDONTWRITEBYTECODE=1

EXPOSE 8080
VOLUME ["/data"]

HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=5 \
    CMD curl -fsS http://127.0.0.1:8080/v1/health || exit 1

ENTRYPOINT ["lewlm"]
CMD ["serve"]
