# Keep the build context small and reproducible. The Dockerfiles copy only
# what they need (requirements/, pyproject.toml, README.md, LICENSE,
# MANIFEST.in, src/, and two helper scripts); everything else listed here is
# still excluded so the context upload stays small and unrelated edits never
# invalidate a layer.
.git
.github
.venv
.venv311
build
dist
*.egg-info
htmlcov
.coverage
.pytest_cache
.mypy_cache
.ruff_cache
.tmp
**/__pycache__
**/*.py[cod]
.DS_Store

# Not part of the wheel or the image.
tests/
docs/
examples/
site/
benchmarks/
*.md
!README.md
mkdocs.yml

# Never copy local model weights / state into the image.
**/*.gguf
**/*.safetensors
**/*.onnx
models/

# Docker + docs artifacts not needed at build time.
Dockerfile*
docker-compose*.yml
.dockerignore
.env
.env.*
